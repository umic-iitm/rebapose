# Server-side credentials (used by server/index.ts)
REVIEWER1_PASSWORD=changeme1
REVIEWER2_PASSWORD=changeme2
ADMIN_PASSWORD=changeme_admin

# Session token signing secret
SESSION_SECRET=your-random-secret-here

# Google Cloud Storage bucket for frame images
GCS_BUCKET=frame-validation-data

# Firestore database ID
# FIRESTORE_DATABASE_ID=rebashotselection

# Server port (default: 3001 for dev, 8080 for production)
# PORT=3001

# Client-side credentials (baked into JS bundle at build time via Vite)
# Only needed if running without the Express backend
VITE_REVIEWER1_PASSWORD=changeme1
VITE_REVIEWER2_PASSWORD=changeme2
VITE_ADMIN_PASSWORD=changeme_admin

# Local frames directory for dev server (vite.config.ts)
# FRAMES_DIR=/path/to/your/frames_annotated
